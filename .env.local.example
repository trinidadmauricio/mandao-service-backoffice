# Mandao Service Backoffice - Environment Variables
# Copia este archivo a .env.local y ajusta los valores según tu entorno

# ============================================
# API Configuration (BACKEND)
# ============================================
# URL base de tu BACKEND (API) - NO incluye /api/v1
# Tu backend corre en el puerto 3001
# En desarrollo: http://localhost:3001
# En producción: https://api.tudominio.com
NEXT_PUBLIC_API_URL=http://localhost:3001

# ============================================
# Application URL (FRONTEND - Opcional)
# ============================================
# URL de tu FRONTEND (backoffice) - Solo si necesitas URLs absolutas
# Tu backoffice corre en el puerto 3000
# En desarrollo: http://localhost:3000
# En producción: https://backoffice.tudominio.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ============================================
# Node Environment
# ============================================
# Entorno de ejecución
# Valores: development, production, test
NODE_ENV=development

# Mapbox
NEXT_PUBLIC_MAPBOX_TOKEN=your_mapbox_token_here
