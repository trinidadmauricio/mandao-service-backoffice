# Mandao Service Backoffice - Environment Variables

# API Configuration
# URL base de la API de Mandao Service (solo dominio, sin /api/v1)
# Ejemplo: http://localhost:3001
# En producción: https://api.mandao.com
NEXT_PUBLIC_API_URL=http://localhost:3001

# Application URL (opcional, para URLs absolutas si es necesario)
# Ejemplo: http://localhost:3000
# En producción: https://backoffice.mandao.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Node Environment
# Valores: development, production, test
NODE_ENV=development
